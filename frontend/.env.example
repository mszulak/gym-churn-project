# FastAPI backend base URL used by Next.js server (Server Actions, Route Handlers).
# In Docker Compose set e.g. http://backend:8000
API_URL=http://localhost:8000

# Fallback used when API_URL is not set:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: disable Secure cookie attribute when testing a production build over plain HTTP
# SESSION_COOKIE_SECURE=false
