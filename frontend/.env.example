# Adres backendu FastAPI używany przez serwer Next.js (Server Actions, Route Handlers).
# W Dockerze ustaw np. http://backend:8000
API_URL=http://localhost:8000

# Alternatywa czytana również, gdy API_URL nie jest ustawione:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Opcjonalnie: wyłącz flagę Secure ciasteczka sesji przy testach produkcyjnego buildu po HTTP (np. w LAN)
# SESSION_COOKIE_SECURE=false
